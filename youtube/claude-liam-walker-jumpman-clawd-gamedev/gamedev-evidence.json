    {
      "beat_id": "B04",
      "path": "features/player/player.gd",
      "start_line": 26,
      "end_line": 31,
      "text": "\tvar shape := RectangleShape2D.new()\n\tshape.size = Vector2(18, 28)\n\tvar collider := CollisionShape2D.new()\n\tcollider.shape = shape\n\tcollider.position = Vector2(0, -14)\n\tadd_child(collider)"
    },
    {
      "beat_id": "B06",
      "path": "features/player/player.gd",
      "start_line": 73,
      "end_line": 81,
      "text": "func visual_animation() -> String:\n\tvar context: String = get_parent().player_animation_context()\n\tif context == \"complete\": return \"celebrate\"\n\tif context == \"failed\": return \"error\"\n\tif not enabled: return \"idle\"\n\tif not is_on_floor(): return \"jump\"\n\tif absf(velocity.x) >= 100: return \"run\"\n\tif absf(velocity.x) > 8: return \"walk\"\n\treturn \"idle\""
    },
    {
      "beat_id": "B08",
      "path": "features/player/clawd_art.gd",
      "start_line": 87,
      "end_line": 88,
      "text": "\tvar s := sample(\"jump\" if airborne else animation, 0.1 if airborne else seconds)\n\tif airborne: s.y = 86 * (1 - s.sy)"
    },
    {
      "beat_id": "B10",
      "path": "game/session.gd",
      "start_line": 3,
      "end_line": 9,
      "text": "func player_animation_context() -> String:\n\t# Presentation reads session state; it never changes the gameplay state machine.\n\tmatch state:\n\t\tState.COMPLETE: return \"complete\"\n\t\tState.DYING: return \"failed\"\n\t\tState.PAUSED: return \"paused\"\n\treturn \"playing\""
    },
    {
      "beat_id": "B12",
      "path": "features/player/player.gd",
      "start_line": 83,
      "end_line": 90,
      "text": "func _process(delta: float) -> void:\n\tif get_parent().player_animation_context() == \"paused\": return\n\tvar next_animation := visual_animation()\n\tif next_animation != animation_name:\n\t\tanimation_seconds = 0.0\n\t\tanimation_name = next_animation\n\tanimation_seconds += delta\n\tqueue_redraw()"
    },
    {
      "beat_id": "B14",
      "path": "levels/first_steps.json",
      "start_line": 8,
      "end_line": 10,
      "text": "  \"solids\": [[0, 320, 448, 64], [512, 320, 224, 64], [784, 320, 176, 64], [160, 304, 48, 16], [576, 288, 48, 32]],\n  \"hazards\": [[320, 304, 24, 16]],\n  \"finish\": [916, 264, 24, 56]"
    },
    {
      "beat_id": "B19",
      "path": "gallery/clawd_gallery.gd",
      "start_line": 34,
      "end_line": 36,
      "text": "\t\tvar animation: String = Art.ANIMATIONS[page * 6 + i]\n\t\tdraw_line(Vector2(x - 60, y + 2), Vector2(x + 60, y + 2), Color(\"ddd8d0\"))\n\t\tArt.paint(self, animation, fmod(seconds, 9.0), Vector2(x, y), 0.55)"
    }
  ],
